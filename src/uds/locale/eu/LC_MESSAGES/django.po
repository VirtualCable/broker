#: notifiers/webhook/notifier.py:202
msgid "HMAC secret"
msgstr "HMAC sekretua"

#: notifiers/webhook/notifier.py:205
msgid ""
"Shared secret used to compute the HMAC-SHA256 signature, exposed through the "
"{{hmac}} placeholder. If empty, no signature is computed and {{hmac}} "
"resolves to an empty string. In 'content' mode, the signature is computed "
"over 'name=value' pairs of all placeholder values (sorted by name, joined "
"with newlines, UTF-8). In 'body' mode, it is computed over the raw body "
"bytes ({{hmac}} cannot be used inside the data template on this mode)."
msgstr ""
"HMAC-SHA256 sinadura kalkulatzeko erabiltzen den sekretu partekatua, honen "
"bidez agerian utzia {{hmac}} leku-markatzailea. Hutsik badago, ez da "
"sinadurarik kalkulatuko eta {{hmac}} kate huts batera ebazten da. 'Edukia' "
"moduan, sinadura balio guztien 'izena=balioa' bikoteen gainean kalkulatzen "
"da (izenaren arabera ordenatuta, lerro berriekin lotuta, UTF-8). 'Gorputza' "
"moduan, gorputz-byte gordinen gainean kalkulatzen da ({{hmac}} ezin da datu-"
"txantiloiaren barruan erabili modu honetan)."

#: notifiers/webhook/notifier.py:217
msgid "HMAC mode"
msgstr "HMAC modua"

#: notifiers/webhook/notifier.py:219
msgid "What is signed: the substituted values (content) or the raw body (body)"
msgstr ""
"Zer da sinatutakoa: ordezkatutako balioak (edukia) edo gorputz gordina "
"(gorputza)"

#: notifiers/webhook/notifier.py:221
msgid "Content"
msgstr "Edukia"

#: notifiers/webhook/notifier.py:222
msgid "Body"
msgstr "Gorputza"

#: notifiers/webhook/notifier.py:243
msgid "Invalid header line (missing ':' separator): {}"
msgstr "Goiburuko lerro baliogabea (':' bereizlea falta da): {}"

#: notifiers/webhook/notifier.py:250
msgid ""
"{{hmac}} placeholder cannot be used inside the data template when HMAC mode "
