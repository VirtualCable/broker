msgstr ""
"Root web/API sarbidea gaituta dago (SUPER_USER_ALLOW_WEBACCESS). Desgaitu "
"ekoizpenean beharrezkoa ez bada."

#: checks/global_config.py:103
msgid "Root web/API access is disabled."
msgstr "Root web/API sarbidea desgaituta dago."

#: checks/global_config.py:113
msgid ""
"Verifies that TRUSTED_SOURCES and ADMIN_TRUSTED_SOURCES are not '*'. These "
"lists limit which addresses can reach the tunnel, actor and administration "
"endpoints. Set them to the networks of your tunnels, machines and "
"administrators."
msgstr ""
"TRUSTED_SOURCES eta ADMIN_TRUSTED_SOURCES ez direla '*' egiaztatzen du. "
"Zerrenda hauek tunelera, aktorera eta administrazio-muturretara zein helbide "
"irits daitezkeen mugatzen dute. Ezarri itzazu zure tunelen, makinen eta "
"administratzaileen sareetara."

#: checks/global_config.py:130
#, python-brace-format
msgid ""
"{wildcards} set to wildcard (*): IP-based gating for tunnels, actors and "
"admin operations is disabled."
msgstr ""
"{wildcards} karaktere arruntera (*) ezarrita: tunel, aktore eta "
"administrazio eragiketetarako IP bidezko atea desgaituta dago."

#: checks/global_config.py:136
msgid "TRUSTED_SOURCES and ADMIN_TRUSTED_SOURCES are not wildcards."
msgstr "TRUSTED_SOURCES eta ADMIN_TRUSTED_SOURCES ez dira komodinak."

#: checks/global_config.py:146
msgid ""
"When the broker is behind a proxy (BEHIND_PROXY), verifies that "
"ALLOWED_IP_FORWARDERS is not '*'. Otherwise any client can fake its address "
"with an X-Forwarded-For header and get around the IP based rules. Set it to "
"the addresses of your proxies or load balancers."
msgstr ""
"Brokerra proxy baten atzean dagoenean (BEHIND_PROXY), ALLOWED_IP_FORWARDERS "
"ez dela '*' egiaztatzen du. Bestela, edozein bezerok bere helbidea faltsutu "
"dezake X-Forwarded-For goiburu batekin eta IP oinarritutako arauak saihestu. "
"Ezarri zure proxy edo karga-banatzaileen helbideetan."

#: checks/global_config.py:159
msgid ""
"Broker is not behind a proxy; the default wildcard ALLOWED_IP_FORWARDERS is "
"not exploitable until BEHIND_PROXY is enabled."
msgstr ""
"Brokerra ez dago proxy baten atzean; ALLOWED_IP_FORWARDERS komodin "
"lehenetsia ezin da erabili BEHIND_PROXY gaituta egon arte."

#: checks/global_config.py:167
msgid ""
"Broker is behind a proxy and ALLOWED_IP_FORWARDERS is a wildcard: any client "
"can spoof X-Forwarded-For. Restrict it to the actual proxy addresses."
msgstr ""
"Brokerra proxy baten atzean dago eta ALLOWED_IP_FORWARDERS txartel komodina "
"da: edozein bezerok X-Forwarded-For imita dezake. Mugatu benetako proxy "
"helbideetara."

#: checks/global_config.py:174
msgid ""
"Broker is behind a proxy and ALLOWED_IP_FORWARDERS is restricted to concrete "
"addresses."
msgstr ""
"Brokerra proxy baten atzean dago eta ALLOWED_IP_FORWARDERS helbide "
"zehatzetara mugatuta dago."

#: checks/global_config.py:184
msgid ""
"Verifies the login lockout settings: MAX_LOGIN_TRIES between 1 and 20, "
"LOGIN_BLOCK of at least 30 seconds and LOGIN_BLOCK_IP enabled. Weaker values "
"make password guessing easier. Adjust them in the global configuration."
msgstr ""
"Saioa hasteko blokeoaren ezarpenak egiaztatzen ditu: MAX_LOGIN_TRIES 1 eta "
"20 artean, LOGIN_BLOCK gutxienez 30 segundokoa eta LOGIN_BLOCK_IP gaituta. "
"Balio ahulagoek pasahitza asmatzea errazten dute. Doitu itzazu konfigurazio "
"orokorrean."

#: checks/global_config.py:199
#, python-brace-format
msgid "MAX_LOGIN_TRIES={value} (recommended: 1-20)"
msgstr "MAX_LOGIN_TRIES= {value} (gomendatua: 1-20)"

#: checks/global_config.py:201
#, python-brace-format
msgid "LOGIN_BLOCK={value}s (recommended: >= 30)"
msgstr "LOGIN_BLOCK= {value} s (gomendatua: >= 30)"

#: checks/global_config.py:203
msgid "LOGIN_BLOCK_IP is off (recommended: on)"
msgstr "LOGIN_BLOCK_IP desaktibatuta dago (gomendatua: piztuta)"

#: checks/global_config.py:209
#, python-brace-format
msgid "Login hardening knobs are weak: {issues}."
msgstr "Saioa hasteko gogortzeko botoiak ahulak dira: {issues} ."

#: checks/global_config.py:214
msgid "Login hardening knobs are within recommended ranges."
msgstr "Saioa hasteko gogortzeko botoiak gomendatutako tarteetan daude."

#: checks/global_config.py:224
msgid ""
"Verifies that BLOCK_ACTOR_FAILURES is enabled, so the addresses that send "
"wrong tokens to the actor endpoints get blocked. Without it, tokens can be "
"tried without limit. Enable it in the global configuration."
msgstr ""
"BLOCK_ACTOR_FAILURES gaituta dagoela egiaztatzen du, aktoreen amaiera-"
"puntuetara token okerrak bidaltzen dituzten helbideak blokeatuta geratu "
"daitezen. Hori gabe, tokenak mugarik gabe probatu daitezke. Gaitu "
"konfigurazio globalean."

#: checks/global_config.py:235
msgid "Actor failure blocking is enabled (BLOCK_ACTOR_FAILURES)."
msgstr "Aktoreen hutsegiteen blokeoa gaituta dago (BLOCK_ACTOR_FAILURES)."

#: checks/global_config.py:241
msgid ""
"Actor failure blocking is disabled (BLOCK_ACTOR_FAILURES): /actor/ endpoints "
"have no rate limit on bad tokens."
msgstr ""
"Aktoreen hutsegiteen blokeoa desgaituta dago (BLOCK_ACTOR_FAILURES): /"
"aktore/ amaiera-puntuek ez dute token akastunentzako tasa-mugarik."

#: checks/global_config.py:253
msgid ""
"Verifies that EXPERIMENTAL_FEATURES is off. Experimental features are not "
"supported and may change or break. Disable it in the global configuration "
"unless you are testing one of them."
msgstr ""
"EXPERIMENTAL_FEATURES desaktibatuta dagoela egiaztatzen du. Ezaugarri "
"esperimentalak ez dira onartzen eta alda edo hondatu egin daitezke. Desgaitu "
"konfigurazio orokorrean, horietako bat probatzen ari ez bazara behintzat."

#: checks/global_config.py:264
msgid "EXPERIMENTAL_FEATURES is on: unsupported functionality is exposed."
msgstr ""
"EXPERIMENTAL_FEATURES aktibatuta dago: funtzionalitate bateraezinak agerian "
"daude."

#: checks/global_config.py:269
msgid "EXPERIMENTAL_FEATURES is off."
msgstr "EXPERIMENTAL_FEATURES desaktibatuta dago."

#: checks/global_config.py:279
msgid ""
"Verifies whether the immutable audit log (IMMUTABLE_LOG_ENABLED) is enabled. "
"When it is, logins and administration events are also written to a tamper-"
"evident log signed by a time stamping authority. Enable it if you need an "
"audit trail that cannot be altered."
msgstr ""
"Aldaezina den auditoria-erregistroa (IMMUTABLE_LOG_ENABLED) gaituta dagoen "
"egiaztatzen du. Gaituta dagoenean, saio-hasierak eta administrazio-gertaerak "
"denbora-zigiluaren agintaritza batek sinatutako manipulazio-babesgarriko "
"erregistro batean idazten dira. Gaitu ezazu aldatu ezin den auditoria-"
"aztarna bat behar baduzu."

#: checks/global_config.py:290
msgid "Immutable audit log is enabled (TSA-signed)."
msgstr "Aldaezina den auditoria-erregistroa gaituta dago (TSAk sinatutakoa)."

#: checks/global_config.py:296
msgid ""
"IMMUTABLE_LOG_ENABLED is off: logins and admin events are not written to the "
"tamper-evident log (src/uds/models/immutable_log.py)."
msgstr ""
"IMMUTABLE_LOG_ENABLED desaktibatuta dago: saio-hasierak eta administratzaile "
"gertaerak ez dira idazten segurtasun-erregistroan (src/uds/models/"
"immutable_log.py)."

#: checks/logs.py:115
msgid ""
"Counts the failed logins of the last 24 hours: from 10 it is a warning and "
"from 50 it may be a brute force attack. The failed logins report shows the "
"users and addresses involved."
msgstr ""
"Azken 24 orduetan huts egindako saio-hasierak zenbatzen ditu: 10etik aurrera "
"abisua da eta 50etik aurrera indar gordineko erasoa izan daiteke. Huts "
"egindako saio-hasieren txostenak inplikatutako erabiltzaileak eta helbideak "
"erakusten ditu."

#: checks/logs.py:127
#, python-brace-format
msgid ""
"{count} failed login attempts in the last 24h: a brute force may be in "
"progress."
msgstr ""
"{count} saioa hasteko saiakera huts egin azken 24 orduetan: indar gordinaren "
"erabilera bat martxan egon daiteke."

#: checks/logs.py:135
#, python-brace-format
msgid "{count} failed login attempts in the last 24h."
msgstr "{count} saiakera huts egin dira azken 24 orduetan."

#: checks/logs.py:140
#, python-brace-format
msgid "{count} failed login attempts in the last 24h (within normal range)."
msgstr ""
"{count} saiakera huts egin dira azken 24 orduetan (tarte normalaren barruan)."

#: checks/logs.py:150
msgid ""
"Groups the failed logins of the last 24 hours by source address and flags "
"every address with 20 or more, a usual sign of password guessing. The "
"details list each flagged address with its count; consider blocking them in "
"the firewall."
msgstr ""
"Azken 24 orduetako huts egindako saio-hasierak iturri-helbidearen arabera "
"multzokatzen ditu eta 20 edo gehiagoko helbide guztiak markatzen ditu, "
"pasahitza asmatzen ari den seinale arrunta. Xehetasunek markatutako helbide "
"bakoitza zerrendatzen dute bere kopuruarekin; kontuan hartu blokeatzea "
"suebakian."

#: checks/logs.py:171
#, python-brace-format
msgid "Brute-force patterns detected by source IP in the last 24h: {top}."
msgstr ""
"Azken 24 orduetan iturri IPak detektatutako indar gordineko ereduak: {top} ."

#: checks/logs.py:177
#, python-brace-format
msgid "No IP exceeds {threshold} failed login attempts in the last 24h."
msgstr ""
"Azken 24 orduetan ez dago {threshold} saiakera huts baino gehiagoko IP "
"helbiderik."

#: checks/logs.py:189
msgid ""
"Counts the accounts temporarily blocked in the last 24 hours after too many "
"wrong passwords. It can be an attack or a client retrying with an old "
"password. The failed logins report shows the users and addresses involved."
msgstr ""
"Azken 24 orduetan pasahitz oker gehiegi sartu ondoren aldi baterako "
"blokeatutako kontuak zenbatzen ditu. Eraso bat izan daiteke edo bezero batek "
"pasahitz zahar batekin berriro saiatzen ari den. Saio-hasiera hutsalen "
"txostenak inplikatutako erabiltzaileak eta helbideak erakusten ditu."

#: checks/logs.py:212
#, python-brace-format
msgid ""
"{count} account(s) were temporarily blocked in the last 24h: an attacker may "
"be cycling credentials under the per-user lockout, or a misconfigured client "
"is retrying with stale credentials."
msgstr ""
"{count} kontu blokeatu dira aldi baterako azken 24 orduetan: erasotzaile "
"batek erabiltzaile bakoitzeko blokeoaren pean kredentzialak birziklatzen ari "
"daiteke, edo gaizki konfiguratutako bezero batek kredentzial zaharkituekin "
"berriro saiatzen ari da."

#: checks/logs.py:220
msgid "No accounts were temporarily blocked in the last 24h."
msgstr "Ez da konturik aldi baterako blokeatu azken 24 orduetan."

#: checks/logs.py:231
msgid ""
"Counts the internal errors logged by the broker in the last 24 hours and "
"warns from 50. A high number usually means a failing provider or service. "
"Check uds.log, services.log and workers.log."
msgstr ""
"Azken 24 orduetan agenteak erregistratutako barne-erroreak zenbatzen ditu "
"eta 50etik aurrera abisatzen du. Zenbaki altu batek normalean hornitzaile "
"edo zerbitzu bat huts egiten ari dela esan nahi du. Begiratu uds.log, "
"services.log eta workers.log."

#: checks/logs.py:252
#, python-brace-format
msgid ""
"{count} internal ERROR entries in the last 24h: check uds.log / "
"services.log / workers.log for failing providers or 5xx storms."
msgstr ""
"{count} barne ERRORE sarrera azken 24 orduetan: egiaztatu uds.log / "
"services.log / workers.log hornitzaile huts egiten dutenak edo 5xx ekaitzak "
"dauden ikusteko."

#: checks/logs.py:259
#, python-brace-format
msgid "{count} internal ERROR entries in the last 24h (within normal range)."
msgstr ""
"{count} barne ERRORE sarrera azken 24 orduetan (tarte normalaren barruan)."

#: checks/logs.py:272
msgid ""
"Counts the scheduler warnings of jobs executed because their last_execution "
"was in the future in the last 24 hours. It means some clock (a broker node "
"or a database node) was out of sync. Any occurrence is worth investigating; "
"the cluster checks (clock drift, timezones, db clock spread) help locate the "
"source."
msgstr ""
"Azken 24 orduetan etorkizunean izandako azken exekuzioa exekutatutako lanen "
"programatzailearen abisuak zenbatzen ditu. Horrek esan nahi du erloju bat "
"(broker nodo bat edo datu-base nodo bat) sinkronizatu gabe zegoela. Edozein "
"gertakari ikertzeko modukoa da; klusterren egiaztapenek (erlojuaren "
"desbideratzea, ordu-zonak, datu-basearen erlojuaren hedapena) iturburua "
"aurkitzen laguntzen dute."

#: checks/logs.py:306
#, python-brace-format
msgid ""
"Scheduler executed {count} job(s) whose last_execution was in the future in "
"the last 24h: clocks were (or are) out of sync between broker or database "
"nodes. Affected jobs: {jobs}."
msgstr ""
"Antolatzailea exekutatu da {count} Azken 24 orduetan etorkizunean azken "
"exekuzioa izan duten lanak: erlojuak sinkronizatu gabe zeuden (edo daude) "
"broker edo datu-base nodoen artean. Kaltetutako lanak: {jobs}."

#: checks/logs.py:314
msgid "No scheduler clock-skew warnings in the last 24h."
msgstr ""
"Ez da programatzailearen erloju-desoreka abisurik jaso azken 24 orduetan."

#: checks/models.py:56
msgid ""
"Verifies that every SAML authenticator requires signed assertions or signed "
"messages. Without a signature, a forged response could be accepted if the "
"IdP is misconfigured. Enable one of the two options in the listed "
"authenticators."
msgstr ""
"SAML autentifikatzaile guztiek sinatutako baieztapenak edo sinatutako mezuak "
"behar dituztela egiaztatzen du. Sinadurarik gabe, erantzun faltsu bat onar "
"daiteke IdP-a gaizki konfiguratuta badago. Gaitu bi aukeretako bat "
"zerrendatutako autentifikatzaileetan."

#: checks/models.py:83
#, python-brace-format
msgid ""
"SAML assertions are not required to be signed on: {unsigned}. Unsigned "
"assertions can be forged against a misconfigured IdP."
msgstr ""
"Ez da beharrezkoa SAML baieztapenak sinatuta egotea: {unsigned}. Sinatu "
"gabeko baieztapenak faltsutu daitezke gaizki konfiguratutako IdP baten aurka."

#: checks/models.py:92
msgid "All SAML authenticators require signed assertions or messages."
msgstr ""
"SAML autentifikatzaile guztiek sinatutako baieztapenak edo mezuak behar "
"dituzte."

#: checks/models.py:97
msgid "No SAML authenticators configured."
msgstr "Ez dago SAML autentifikatzailerik konfiguratuta."

#: checks/models.py:107
msgid ""
"Looks for machines whose actor still authenticates with the old token, the "
"one based on the user service id. Re-initialize the actor on the machines of "
"the listed service pools so they move to the new token."
msgstr ""
"Makinak bilatzen ditu aktorea oraindik token zaharrarekin autentifikatzen "
"dutenak, erabiltzaile-zerbitzuaren IDan oinarritutakoarekin. Berrabiarazi "
"aktorea zerrendatutako zerbitzu-multzoetako makinetan, token berrira mugi "
"daitezen."

#: checks/models.py:139
#, python-brace-format
msgid ""
"Service pools with actors still using the legacy uuid token flow: "
"{affected}. Re-initialize affected actors to rotate them to the new token."
msgstr ""
"Aktoreek oraindik uuid token-fluxu zaharra erabiltzen duten zerbitzu-"
"multzoak: {affected}. Berriro hasieratu kaltetutako aktoreak token berrira "
"biratzeko."

#: checks/models.py:147
msgid "No user services are using the legacy uuid actor token flow."
msgstr ""
"Ez dago erabiltzaile-zerbitzurik uuid aktorearen token-fluxu zaharra "
"erabiltzen ari denik."

#: checks/models.py:157
msgid ""
"Verifies that at least one authenticator has multi-factor authentication "
"(MFA) assigned; it only fails when none has. The details list the "
"authenticators without MFA. Assign an MFA to the authenticators your users "
"log in with."
msgstr ""
"Gutxienez autentifikatzaile batek faktore anitzeko autentifikazioa (MFA) "
"esleituta duela egiaztatzen du; bat ere ez duenean bakarrik huts egiten du. "
"Xehetasunek MFArik gabeko autentifikatzaileak zerrendatzen dituzte. Esleitu "
"MFA bat zure erabiltzaileek saioa hasteko erabiltzen dituzten "
"autentifikatzaileei."

#: checks/models.py:169
msgid "No authenticators configured (nothing to enforce MFA on)."
msgstr ""
"Ez dago autentifikatzailerik konfiguratuta (ez dago ezer MFA betearazteko)."

#: checks/models.py:177
#, python-brace-format
msgid ""
"No authenticator has MFA configured: {names}. Assign at least one MFA per "
"authenticator."
msgstr ""
"Ez dago MFA konfiguratuta duen autentifikatzailerik: {names} . Esleitu "
"gutxienez MFA bat autentifikatzaile bakoitzeko."

#: checks/models.py:184
#, python-brace-format
msgid "MFA coverage: {with_mfa}/{total} authenticators have MFA assigned."
msgstr ""
"MFA estaldura: {with_mfa} / {total} autentifikatzailek MFA dute esleituta."

#: checks/models.py:198
msgid ""
"Reads the certificates of the registered servers and warns when one has "
"expired, expires within 30 days or cannot be read. Connections to a server "
"with an expired certificate fail. Renew the certificate of the listed "
"servers."
msgstr ""
"Erregistratutako zerbitzarien ziurtagiriak irakurtzen ditu eta abisatzen du "
"bat iraungi denean, 30 eguneko epean iraungitzen denean edo ezin denean "
"irakurri. Ziurtagiri iraungi bat duen zerbitzari baterako konexioek huts "
"egiten dute. Berritu zerrendatutako zerbitzarien ziurtagiria."

#: checks/models.py:250
#, python-brace-format
msgid ""
"{n} server certificate(s) have expired: {names}. Renew and rotate the "
"affected servers."
msgstr ""
"{n} zerbitzari-ziurtagiri iraungi dira: {names} . Berritu eta txandakatu "
"kaltetutako zerbitzariak."

#: checks/models.py:258
#, python-brace-format
msgid "{n} server certificate(s) expire within 30 days: {names}."
msgstr "{n} zerbitzari-ziurtagiri 30 eguneko epean iraungitzen dira: {names} ."

#: checks/models.py:266
msgid "No server certificates expire within the next 30 days."
msgstr "Ez da zerbitzari-ziurtagiririk iraungiko hurrengo 30 egunetan."

#: checks/models.py:277
msgid ""
"Lists the service pools that UDS has restrained because too many of their "
"machines failed in a short time. A restrained pool stops creating machines. "
"Check the logs of the pool and its provider to find the cause."
msgstr ""
"UDS-k mugatu dituen zerbitzu-multzoak zerrendatzen ditu, denbora gutxian "
"makina gehiegi huts egin dutelako. Mugatutako multzo batek makinak sortzeari "
"uzten dio. Begiratu multzoaren eta bere hornitzailearen erregistroak kausa "
"aurkitzeko."

#: checks/models.py:300
#, python-brace-format
msgid "{n} service pool(s) are currently restrained: {names}."
msgstr "{n} zerbitzu multzo mugatuta daude une honetan: {names} ."

#: checks/models.py:308
msgid "No service pools are currently restrained."
msgstr "Ez dago zerbitzu multzo mugaturik une honetan."

#: checks/models.py:318
msgid ""
"Looks for LDAP authenticators that use SSL without verifying the server "
"certificate, and SAML authenticators that download the IdP metadata over "
"HTTPS without verifying it. Anyone able to intercept that traffic can "
"impersonate the directory or the identity provider. Enable the verification "
"and install the CA if it is an internal one."
msgstr ""
"SSL erabiltzen duten LDAP autentifikatzaileak bilatzen ditu zerbitzariaren "
"ziurtagiria egiaztatu gabe, eta IdP metadatuak HTTPS bidez deskargatzen "
"dituzten SAML autentifikatzaileak, egiaztatu gabe. Trafiko hori atzeman "
"dezakeen edonork direktorioa edo identitate hornitzailea ordezkatu dezake. "
"Gaitu egiaztapena eta instalatu CA barnekoa bada."

#: checks/models.py:352
#, python-brace-format
msgid ""
"TLS certificate verification is disabled on: {names}. Anyone able to "
"intercept the traffic can impersonate the directory or the identity "
"provider. Enable the verification and install the CA if it is an internal "
"one."
msgstr ""
"TLS ziurtagiriaren egiaztapena desgaituta dago hemen: {names}. Trafikoa "
"atzeman dezakeen edonork direktorioa edo identitate-hornitzailea ordezkatu "
"dezake. Gaitu egiaztapena eta instalatu CA barnekoa bada."

#: checks/models.py:361
msgid "All authenticators using TLS verify the certificate of the other end."
msgstr ""
"TLS erabiltzen duten autentifikatzaile guztiek beste muturreko ziurtagiria "
"egiaztatzen dute."

#: checks/network.py:73
msgid ""
"When 'Behind a proxy' is off, checks whether most of the logins of the last "
"24 hours come from one private address. That usually means UDS sees the load "
"balancer instead of the clients, so IP blocking and IP based rules apply to "
"everybody at once. Enable 'Behind a proxy' and add the balancer to 'Allowed "
"IP Forwarders'."
msgstr ""
"'Proxy baten atzean' desaktibatuta dagoenean, azken 24 orduetako saio-"
"hasiera gehienak helbide pribatu batetik datozen egiaztatzen du. Horrek "
"normalean esan nahi du UDS-k karga-banatzailea ikusten duela bezeroen ordez, "
"beraz, IP blokeatzea eta IP oinarritutako arauak aldi berean aplikatzen "
"zaizkie guztiei. Gaitu 'Proxy baten atzean' eta gehitu balatzailea 'IP "
"birbidaltzaile baimenduak' atalean."

#: checks/network.py:85
msgid ""
"'Behind a proxy' is enabled: client addresses are taken from X-Forwarded-For."
msgstr ""
"'Proxy baten atzean' gaituta dago: bezeroen helbideak X-Forwarded-For-etik "
"hartzen dira."

#: checks/network.py:108
#, python-brace-format
msgid ""
"{share:.0%} of the users that logged in during the last 24h came from {ip}, "
"a private address, and 'Behind a proxy' is disabled. UDS is probably seeing "
"the address of a load balancer instead of the client's: blocking by IP and "
"IP-based access rules apply to everybody at once. Enable 'Behind a proxy' "
"and trust the balancer in 'Allowed IP Forwarders'."
msgstr ""
"{share:.0%} azken 24 orduetan saioa hasi duten erabiltzaileen artean "
"hemendik zetozen {ip}, helbide pribatu bat, eta 'Proxy baten atzean' "
"desgaituta dago. UDS-k ziurrenik karga-banatzaile baten helbidea ikusten ari "
"da bezeroarenaren ordez: IP bidezko blokeoa eta IP oinarritutako sarbide-"
"arauak aldi berean aplikatzen zaizkie guztiei. Gaitu 'Proxy baten atzean' "
"eta fidatu orekatzaileaz 'Onartutako IP birbidaltzaileak' atalean."

#: checks/network.py:124
msgid "Client addresses in the login log look like real client addresses."
msgstr ""
"Saioa hasteko erregistroan agertzen diren bezeroen helbideak benetako "
"bezeroen helbideen itxura dute."

#: checks/network.py:134
msgid ""
"Lists the addresses blocked for actor access in the last 24 hours after too "
"many wrong requests. Actors behind a blocked address cannot report their "
"state until the block expires, and if several machines share the address "
"(NAT, proxy) one failing actor blocks all of them."
msgstr ""
"Azken 24 orduetan aktoreen sarbidea blokeatu duten helbideak zerrendatzen "
"ditu, eskaera oker gehiegi egin ondoren. Blokeatutako helbide baten atzean "
"dauden aktoreek ezin dute beren egoeraren berri eman blokeoa iraungi arte, "
"eta hainbat makinak helbidea partekatzen badute (NAT, proxy), aktore batek "
"huts egiten badu, guztiak blokeatzen ditu."

#: checks/network.py:160
#, python-brace-format
msgid ""
"{count} address(es) were blocked for actor access in the last 24h: "
"{examples}. Actors behind those addresses cannot report their state until "
"the block expires. If several machines share one address (NAT, proxy), one "
"failing actor blocks all of them."
msgstr ""
"{count} Helbide hauek blokeatu dira aktoreen sarbidearentzat azken 24 "
"orduetan: {examples}. Helbide horien atzean dauden aktoreek ezin dute beren "
"egoeraren berri eman blokeoa iraungi arte. Hainbat makinak helbide bera "
"partekatzen badute (NAT, proxy), aktore batek huts egiten badu, guztiak "
"blokeatzen ditu."

#: checks/network.py:169
#| msgid "No accounts were temporarily blocked in the last 24h."
msgid "No addresses were blocked for actor access in the last 24h."
msgstr "Ez da aktoreen sarbidea blokeatu azken 24 orduetan."

#: checks/osmanagers.py:68
msgid ""
"Counts the domain join errors reported by the actors in the last 24 hours, "
"grouped by service pool. Check the account, password and OU of the OS "
"manager and that the machines can reach the domain controllers."
msgstr ""
"Aktoreek azken 24 orduetan jakinarazitako domeinu-lotura erroreak zenbatzen "
"ditu, zerbitzu-multzoaren arabera multzokatuta. Egiaztatu sistema "
"eragilearen kudeatzailearen kontua, pasahitza eta OU, eta egiaztatu makinak "
"domeinu-kontrolagailuetara irits daitezkeela."

#: checks/osmanagers.py:96
#, python-brace-format
msgid ""
"{count} domain join error(s) reported by the actors in the last 24h: "
"{examples}. Check the account, password and OU of the OS manager and that "
"the machines reach the domain controllers."
msgstr ""
"{count} aktoreek azken 24 orduetan jakinarazitako domeinu-lotura errorea(k): "
"{examples}. Egiaztatu sistema eragilearen kudeatzailearen kontua, pasahitza "
"eta OUa, eta egiaztatu makinak domeinu-kontrolagailuetara iristen direla."

#: checks/osmanagers.py:99
#| msgid "Item already being removed"
msgid "machines already removed"
msgstr "makinak dagoeneko kenduta"

#: checks/osmanagers.py:105
msgid "No domain join errors reported by the actors in the last 24h."
msgstr "Aktoreek ez dute domeinu-lotura errorerik jakinarazi azken 24 orduetan."

#: checks/providers.py:58
msgid ""
"Counts the errors of the last 24 hours for each provider, including the "
"errors of its machines, and flags the providers with 10 or more. Check their "
"credentials, connectivity and the hypervisor logs."
msgstr ""
"Hornitzaile bakoitzaren azken 24 orduetako erroreak zenbatzen ditu, bere "
"makinen erroreak barne, eta hornitzaileak 10 edo gehiagorekin markatzen "
"ditu. Egiaztatu haien kredentzialak, konexioa eta hiperbisorearen "
"erregistroak."

#: checks/providers.py:97
#, python-brace-format
msgid ""
"Providers with {threshold} or more errors in the last 24h: {examples}. Check "
"their credentials and the hypervisor logs."
msgstr ""
"Hornitzaileak dituztenak {threshold} edo akats gehiago azken 24 orduetan: "
"{examples}. Egiaztatu haien kredentzialak eta hiperbisorearen erregistroak."

#: checks/providers.py:105
msgid "No provider has repeated errors in the last 24h."
msgstr ""
"Ez da hornitzaile batek azken 24 orduetan errore errepikatuak izan dituenik."

#: checks/providers.py:115
msgid ""
"Lists the providers left in maintenance mode. No machines are created or "
"removed on them until maintenance is turned off, so turn it off when the "
"maintenance is over."
msgstr ""
"Mantentze-lanak amaitu arte, mantentze-lanak itzali arte, ez da makinarik "
"sortzen edo kentzen hornitzaileak zerrendatzen ditu, beraz, itzali mantentze-"
"lanak amaitutakoan."

#: checks/providers.py:131
#, python-brace-format
msgid ""
"Providers in maintenance mode: {names}. No machines are created or removed "
"on them until maintenance is turned off."
msgstr ""
"Mantentze-lanetan dauden hornitzaileak: {names}. Ez da makinarik sortu edo "
"kendu haietan mantentze-lanak itzali arte."

#: checks/providers.py:139
#| msgid "Server is in maintenance mode"
msgid "No providers in maintenance mode."
msgstr "Ez dago mantentze-lanetan dauden hornitzailerik."

#: checks/publications.py:71
msgid ""
"Looks for publications that have been preparing, removing or canceling for "
"longer than MAX_PUBLICATION_TIME. They will not finish by themselves. Check "
"the provider, then retry or cancel the publication."
msgstr ""
"MAX_PUBLICATION_TIME baino denbora gehiagoz prestatzen, kentzen edo bertan "
"behera uzten ari diren argitalpenak bilatzen ditu. Ez dira bere kabuz "
"amaituko. Egiaztatu hornitzailea, eta saiatu berriro edo bertan behera utzi "
"argitalpena."

#: checks/publications.py:103
#, python-brace-format
msgid ""
"{n} publication(s) stuck in a transitional state for more than {hours}h: "
"{examples}. The publication task will not complete by itself; check the "
"provider and retry or cancel."
msgstr ""
"{n} argitalpena(k) trantsizio-egoera batean trabatuta baino gehiagoz {hours}"
"h: {examples}. Argitalpen-zeregina ez da bere kabuz osatuko; egiaztatu "
"hornitzailea eta saiatu berriro edo bertan behera utzi."

#: checks/publications.py:111
#, python-brace-format
msgid "No publications stuck in transitional states for more than {hours}h."
msgstr ""
"Ez dago trantsizio-egoeretan baino gehiagoz trantsizio-egoeretan trabatuta "
"dagoen argitalpenik {hours}h."

#: checks/settings.py:54
msgid ""
"Verifies that the session and CSRF cookies are marked HttpOnly and Secure "
"and that ENHANCED_SECURITY is enabled. Without these flags the cookies can "
"be read by scripts or sent over plain HTTP. Enable the missing flags in the "
"broker settings and ENHANCED_SECURITY in the global configuration."
msgstr ""
"Saioko eta CSRF cookieak HttpOnly eta Secure gisa markatuta daudela eta "
"ENHANCED_SECURITY gaituta dagoela egiaztatzen du. Bandera hauek gabe, "
"cookieak scriptek irakurri edo HTTP soilaren bidez bidali ditzakete. Gaitu "
"falta diren banderak broker ezarpenetan eta ENHANCED_SECURITY konfigurazio "
"orokorrean."

#: checks/settings.py:74
#, python-brace-format
msgid "Security cookies/headers are disabled: {missing}."
msgstr "Segurtasun cookieak/goiburuak desgaituta daude: {missing}."

#: checks/settings.py:79
msgid "Session/security cookies and enhanced security are enabled."
msgstr "Saio/segurtasun cookieak eta segurtasun hobetua gaituta daude."

#: checks/settings.py:89
msgid ""
"Verifies that DEBUG and PROFILING are off in the broker settings. With DEBUG "
"on, error pages show code, settings and queries to anyone who triggers an "
"error. Set both to False and restart the broker."
msgstr ""
"DEBUG eta PROFILING desaktibatuta daudela egiaztatzen du brokerren "
"ezarpenetan. DEBUG aktibatuta dagoenean, errore-orrialdeek kodea, ezarpenak "
"eta kontsultak erakusten dizkiete errore bat eragiten duen edonori. Ezarri "
"biak False baliora eta berrabiarazi brokerra."

#: checks/settings.py:105
#, python-brace-format
msgid ""
"Production debug switches are on: {problems}. Disable both in production."
msgstr ""
"Ekoizpeneko arazketa-etengailuak piztuta daude: {problems} . Desgaitu biak "
"ekoizpenean."

#: checks/settings.py:112
msgid "DEBUG and PROFILING are both off."
msgstr "DEBUG eta PROFILING desaktibatuta daude."

#: checks/settings.py:122
msgid ""
"Verifies that SECRET_KEY is not the sample value shipped with UDS. That key "
"signs sessions and tokens, so anyone who knows it can forge them. Set a new "
"random SECRET_KEY in the broker settings, the same on every broker."
msgstr ""
"SECRET_KEY ez dela UDSrekin batera bidalitako lagin-balioa egiaztatzen du. "
"Giltza horrek saioak eta tokenak sinatzen ditu, beraz, ezagutzen duen "
"edonork faltsutu ditzake. Ezarri ausazko SECRET_KEY berri bat brokerren "
"ezarpenetan, broker guztietan berdina."

#: checks/settings.py:133
msgid ""
"settings.SECRET_KEY is the shipped sample value: session tokens can be "
"forged."
msgstr ""
"settings.SECRET_KEY bidalitako lagin-balioa da: saio-tokenak faltsutu "
"daitezke."

#: checks/settings.py:138
msgid "settings.SECRET_KEY has been rotated."
msgstr "settings.SECRET_KEY biratu da."

#: checks/settings.py:148
msgid ""
"Verifies that RSA_KEY is not the sample key shipped with UDS. That key "
"encrypts the secrets stored by the broker, so anyone who knows it can "
"decrypt them. Replacing it affects the data already encrypted, so plan the "
"change before doing it."
msgstr ""
"RSA_KEY ez dela UDSrekin batera bidalitako lagin-gakoa egiaztatzen du. Gako "
"horrek bitartekariak gordetako sekretuak enkriptatzen ditu, beraz, ezagutzen "
"duen edonork deszifratu ditzake. Ordezkatzeak dagoeneko enkriptatutako "
"datuei eragiten die, beraz, planifikatu aldaketa egin aurretik."

#: checks/settings.py:162
msgid ""
"settings.RSA_KEY is the shipped sample value: anyone can decrypt broker "
"secrets."
msgstr ""
"settings.RSA_KEY bidalitako lagin-balioa da: edonork deszifra ditzake broker "
"sekretuak."

#: checks/settings.py:167
msgid "settings.RSA_KEY has been rotated."
msgstr "settings.RSA_KEY biratu da."

#: checks/settings.py:177
msgid ""
"Verifies that Django's CsrfViewMiddleware is enabled. Without it, a "
"malicious page can make the browser of a logged-in administrator send "
"requests to the broker. Add django.middleware.csrf.CsrfViewMiddleware back "
"to MIDDLEWARE in the broker settings."
msgstr ""
"Djangoren CsrfViewMiddleware gaituta dagoela egiaztatzen du. Hori gabe, "
"orrialde gaizto batek saioa hasi duen administratzaile baten arakatzailea "
"brokerrari eskaerak bidaltzera behartu dezake. Gehitu "
"django.middleware.csrf.CsrfViewMiddleware berriro MIDDLEWAREra brokerren "
"ezarpenetan."

#: checks/settings.py:190
msgid ""
"django.middleware.csrf.CsrfViewMiddleware is not in MIDDLEWARE: cross-site "
"request forgery is not mitigated at the framework level."
msgstr ""
"django.middleware.csrf.CsrfViewMiddleware ez dago MIDDLEWARE-n: gune arteko "
"eskaeren faltsutzea ez da arintzen esparru mailan."

#: checks/settings.py:197
msgid "django.middleware.csrf.CsrfViewMiddleware is active."
msgstr "django.middleware.csrf.CsrfViewMiddleware aktibo dago."

#: checks/settings.py:207
msgid ""
"Verifies that the SQL logger is not at DEBUG when DEBUG is off. At that "
"level every query is written to log/sql.log with its values, including "
"passwords and personal data. Raise the level of the 'django.db.backends' "
"logger in the broker settings."
msgstr ""
"SQL erregistratzailea ez dagoela DEBUG egoeran egiaztatzen du DEBUG itzalita "
"dagoenean. Maila horretan kontsulta guztiak log/sql.log fitxategian idazten "
"dira bere balioekin, pasahitzak eta datu pertsonalak barne. Igo "
"'django.db.backends' erregistratzailearen maila broker ezarpenetan."

#: checks/settings.py:225
msgid ""
"SQL logger 'django.db.backends' is at DEBUG while DEBUG is off: every SQL "
"statement with bound values is being written to log/sql.log on disk."
msgstr ""
"'django.db.backends' SQL erregistroa DEBUG egoeran dago DEBUG itzalita "
"dagoen bitartean: balio lotuak dituen SQL adierazpen guztiak diskoan log/"
"sql.log fitxategian idazten ari dira."

#: checks/settings.py:232
msgid ""
"SQL logger 'django.db.backends' is not writing bound SQL to disk in "
"production."
msgstr ""
"'django.db.backends' SQL erregistratzaileak ez du lotutako SQLrik diskoan "
"idazten ekoizpenean."

#: checks/settings.py:242
msgid ""
"Verifies that the root and 'uds' loggers are not at DEBUG. DEBUG logs grow "
"fast and may contain sensitive data. Set their level to INFO or higher in "
"the broker settings."
msgstr ""
"Egiaztatzen du erroko eta 'uds' erregistroak ez daudela DEBUG egoeran. DEBUG "
"erregistroak azkar hazten dira eta datu sentikorrak izan ditzakete. Ezarri "
"haien maila INFO edo altuagora broker ezarpenetan."

#: checks/settings.py:260
msgid "Root or 'uds' logger is at DEBUG in production (verbose logs on disk)."
msgstr ""
"Erroko edo 'uds' erregistratzailea DEBUG egoeran dago ekoizpenean (diskoan "
"erregistro zehatzak)."

#: checks/settings.py:265
msgid "Root and 'uds' loggers are above DEBUG in production."
msgstr ""
"Root eta 'uds' erregistratzaileak DEBUG-aren gainetik daude ekoizpenean."

#: checks/user_services.py:73
msgid ""
"Looks for user services that have been preparing for longer than "
"MAX_INITIALIZING_TIME, or that are ready on the provider but whose actor "
"never reported. Nothing removes them on their own. Check the provider and "
"whether the actor inside the machine can reach the broker; the details list "
"the affected pools."
msgstr ""
"MAX_INITIALIZING_TIME baino denbora gehiagoz prestatzen ari diren "
"erabiltzaile-zerbitzuak bilatzen ditu, edo hornitzailean prest daudenak, "
"baina haien aktoreak inoiz jakinarazi ez dutenak. Ezerk ez ditu bere kabuz "
"kentzen. Egiaztatu hornitzailea eta makinaren barruko aktorea bitartekarira "
"irits daitekeen; xehetasunek kaltetutako multzoak zerrendatzen dituzte."

#: checks/user_services.py:93
#, python-brace-format
msgid ""
"{count} user service(s) have been preparing for more than {hours:.0f}h: "
"{pools}. Nothing removes them on their own; check the provider and whether "
"the actor inside the machine can reach the broker."
msgstr ""
"{count} erabiltzaile-zerbitzuak baino gehiagorako prestatzen ari dira "
"{hours:.0f}h: {pools}. Ezerk ez ditu bere kabuz kentzen; egiaztatu "
"hornitzailea eta makinaren barruko aktoreak bitartekariarengana irits "
"daitekeen ala ez."

#: checks/user_services.py:102
#| msgid "User services in error"
msgid "No user services stuck in preparation."
msgstr "Ez dago prestaketan trabatuta dauden erabiltzaile-zerbitzurik."

#: checks/user_services.py:112
msgid ""
"Looks for assigned user services that nobody has used for more than 90 days. "
"They count against the pool limits and keep capacity on the provider. The "
"details list the affected pools; consider removing the machines or "
"unassigning them."
msgstr ""
"90 egun baino gehiagoz inork erabili ez dituen esleitutako erabiltzaile-"
"zerbitzuak bilatzen ditu. Multzoen mugen aurka zenbatzen dira eta "
"hornitzailearen edukiera mantentzen dute. Xehetasunek kaltetutako multzoak "
"zerrendatzen dituzte; kontuan hartu makinak kentzea edo esleipena kentzea."

#: checks/user_services.py:134
#, python-brace-format
msgid ""
"{count} assigned user service(s) have not been used for more than {days} "
"days: {pools}. They count against the pool limits and keep capacity on the "
"provider."
msgstr ""
"{count} esleitutako erabiltzaile-zerbitzua(k) ez dira erabili baino gehiagoz "
"{days} egunak: {pools}. Multzoen mugen aurka zenbatzen dira eta "
"hornitzailearen edukiera mantentzen dute."

#: checks/user_services.py:142
#, python-brace-format
msgid "No assigned user services unused for more than {days} days."
msgstr ""
"Ez dago esleitutako erabiltzaile-zerbitzurik erabili gabe baino gehiagoz "
"{days} egunak."

#: checks/users.py:58
msgid ""
"Looks for users of the same authenticator whose names only differ in case, "
"spacing or equivalent Unicode characters. Some databases allow them, and "
"each copy gets its own services and permissions. Remove or merge the "
"duplicated users listed in the details."
msgstr ""
"Autentifikatzaile beraren erabiltzaileak bilatzen ditu, eta haien izenak "
"letra larriz edo minuskulaz, tartez edo Unicode karaktere baliokideetan "
"bakarrik desberdinak dira. Datu-base batzuek onartzen dituzte, eta kopia "
"bakoitzak bere zerbitzuak eta baimenak ditu. Xehetasunetan zerrendatutako "
"erabiltzaile bikoiztuak kendu edo batu."

#: checks/users.py:86
#, python-brace-format
msgid ""
"{count} user name(s) are duplicated inside an authenticator once case and "
"spacing are ignored: {examples}. Each copy gets its own services and "
"permissions."
msgstr ""
"{count} Erabiltzaile-izenak bikoiztuta daude autentifikatzaile baten "
"barruan, maiuskula/minuskulak eta tarteak alde batera uzten direnean: "
"{examples}. Kopia bakoitzak bere zerbitzuak eta baimenak ditu."

#: checks/users.py:97
#| msgid "All seems fine in the authenticator."
msgid "No duplicated user names inside the authenticators."
msgstr "Ez dago erabiltzaile-izen bikoizturik autentifikatzaileen barruan."

#: checks/webhook_queue.py:57
msgid ""
"Counts the webhook notifications waiting to be delivered: from 2000 it "
"warns, and from 10000 the queue is close to its limit and new events will be "
"dropped. A growing queue means an endpoint is failing or unreachable. Check "
"the webhook notifiers and their endpoints."
msgstr ""
"Bidaltzeko zain dauden webhook jakinarazpenak zenbatzen ditu: 2000tik "
"aurrera abisua ematen du, eta 10000tik aurrera ilara mugara hurbiltzen da "
"eta gertaera berriak baztertuko dira. Ilara hazten ari den batek amaiera-"
"puntua huts egiten ari dela edo eskuraezina dela esan nahi du. Egiaztatu "
"webhook jakinarazleak eta haien amaiera-puntuak."

#: checks/webhook_queue.py:74
#, python-brace-format
msgid ""
"Webhook notification queue holds {n} pending events (near the {cap} enqueue "
"cap). Check the destination endpoints: undeliverable events will be dropped "
"when the cap is reached."
msgstr ""
"Webhook jakinarazpenen ilaran dauden edukiak {n} gertakari zain (hurbil) "
"{cap} ilaran jarri muga). Egiaztatu helmugako amaiera-puntuak: entregatu "
"ezin diren gertaerak baztertuko dira mugara iristen denean."

#: checks/webhook_queue.py:83
#, python-brace-format
msgid ""
"Webhook notification queue is growing ({n} pending events). Some webhook "
"endpoint is probably failing or unreachable."
msgstr ""
"Webhook jakinarazpenen ilara hazten ari da ({n} gertaera zain). Webhook "
"amaierako punturen bat huts egiten ari da edo ezin da eskuratu."

#: checks/webhook_queue.py:90
#, python-brace-format
msgid "Webhook notification queue size is under control ({n} pending events)."
msgstr ""
"Webhook jakinarazpen-ilararen tamaina kontrolpean dago ({n} zain dauden "
"gertaerak)."

